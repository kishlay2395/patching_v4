#!/bin/bash

IMPL_NAME=$1
MYAPP_PATH=$(pwd)  # Get current working directory
MYAPP_PATH_OUTPATH="$(realpath "${MYAPP_PATH}/../output")"  # Convert to absolute path
MYDATE="$(date -u +"%Y-%m-%d")"
MYDATETIME="$(date -u +%Y-%m-%d-%H-%M-%S)"

OUTPUT_DIR="${MYAPP_PATH_OUTPATH}/${IMPL_NAME}"

# Ensure directory exists
if [ ! -d "$OUTPUT_DIR" ]; then
    echo "Error: OUTPUT_DIR $OUTPUT_DIR does not exist!"
    exit 1
fi

# Get list of files safely
files=$(find "$OUTPUT_DIR" -type f -printf "%f\n")

# Extract unique IP addresses from filenames
IP_ADDRESSES=$(echo "$files" | awk -F'-' '{print $1}' | sort -u)

echo "Checking for latest files for each IP address..."
echo "-----------------------------------------------"

# Loop through each unique IP address
for IP in $IP_ADDRESSES; do
    # Find latest "AfterPatching" file for the IP
    LATEST_FILE_AFTER_PATCH=$(echo "$files" | grep "^${IP}-.*AfterPatching" | sort -t'-' -k3,4 -r | head -n 1)
    LATEST_FILE_BEFORE_PATCH=$(echo "$files" | grep "^${IP}-.*BeforePatching" | sort -t'-' -k3,4 -r | head -n 1)

    # Print results
    if [ -n "$LATEST_FILE_AFTER_PATCH" ]; then
        echo "Latest AfterPatching file for IP $IP: $LATEST_FILE_AFTER_PATCH"
    else
        echo "No AfterPatching files found for IP $IP"
		exit 
    fi
    
    if [ -n "$LATEST_FILE_BEFORE_PATCH" ]; then
        echo "Latest BeforePatching file for IP $IP: $LATEST_FILE_BEFORE_PATCH"
		exit 
    else
        echo "No BeforePatching files found for IP $IP"
		exit
    fi

    echo "-----------------------------------------------"
	
	bash $MYAPP_PATH/final_output.sh ${OUTPUT_DIR}/${LATEST_FILE_BEFORE_PATCH} ${OUTPUT_DIR}/${LATEST_FILE_AFTER_PATCH}
done


