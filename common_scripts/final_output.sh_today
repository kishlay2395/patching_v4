print_app_status_details_old() {
    local title="Application Process Details"

    # Header
	printf "\n%-40s | %-20s | %-20s | %-20s | %-20s | %-20s\n" \
    "URL Address" "Pre-Check-Status" "Post-Check-Status" "StatusCmp" "Pre_Http_Code" "Post_Http_Code"

	# Print a separator line
	printf "%-40s | %-20s | %-20s | %-20s | %-20s | %-20s\n" \
    "----------------------------------------" "--------------------" "--------------------" "--------------------" "--------------------" "--------------------"

    # Declare associative arrays
    declare -A file1_status file2_status file1_code file2_code

    # Parse File 1
    awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { 
            if (found) exit;  
            found=1;
            next;
        }
        found { print $4}
    ' "$Input_File2" | while read -r field6 field7 field8; 
	do
        file1_status["$field6"]="$field7"
        file1_code["$field6"]="$field8"
    done

    # Parse File 2
	awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { 
            if (found) exit;  
            found=1;
            next;
        }
        found { print $4}
    ' "$Input_File2" | while read -r field6 field7 field8; 
	do
        file1_status["$field6"]="$field7"
        file1_code["$field6"]="$field8"
    done


    # Compare and display results
    for key in "${!file1_status[@]}"; do
        status1="${file1_status[$key]}"
        status2="${file2_status[$key]}"
        code1="${file1_code[$key]}"
        code2="${file2_code[$key]}"

        status_cmp="MATCH"
        [[ "$status1" != "$status2" ]] && status_cmp="MISMATCH"

        code_cmp="match"
        [[ "$code1" != "$code2" ]] && code_cmp="mismatch"

        printf "%-40s | %-20s | %-20s | %-20s | %-20s | %-20s\n" \
            "$key" "$status1" "$status2" "$status_cmp" "$code1" "$code2"
    done
}

print_section_aviable() {
    local title="$1"
    local pattern1="$2"
	local pattern2="$3"

    # Extract values from both input files
	if grep -q -m 1 "$pattern1" "$Input_File1" ; then 	
		value1="Service Available"
	elif grep -q -m 1 "$pattern2" "$Input_File1" ; then
		value1="Service is Unavailable."
	else
		value1="Status not found in log."
	fi
	
    # Assign default values based on conditions for value2
    # Extract values from both input files
    if grep -q -m 1 "$pattern1" "$Input_File2" ; then 	
		value2="Service Available"
	elif grep -q -m 1 "$pattern2" "$Input_File2" ; then
		value2="Service is UnAvailable"
	else
		value2="Status not found in log."
	fi
	
	if [[ "$app_count1" == "$app_count2" ]]; then
		status="Validated"
	else	
		status="Need Attention"
	fi	

    # Print formatted output
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}






print_crystal_section() {
    local title="$1"
    local pattern="$2"

    # Extract values from both input files
    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk '{$1=""; print $(NF-2), $(NF-1), $NF}' | xargs)
	
    # Assign default values based on conditions for value1
    if [[ "$value1" == "does not exist." ]]; then
        value1="Does not exist"
    else
        if [[ "$title" == "pref.xml system level directory" ]]; then
            if grep -wq ".systemPrefs/com/inet/report/config/cc/Default/prefs.xml" "$Input_File1"; then
                value1="System level folder & file found"
            fi
        elif [[ "$title" == "pref.xml user level directory" ]]; then
            if grep -wq ".java/.userPrefs/com/inet/report/config/cc/Default/prefs.xml" "$Input_File1"; then
                value1="$title Folder/File Found"
            fi
        else
            value1="$title Folder Found"
        fi
    fi
	
	local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk '{$1=""; print $(NF-2), $(NF-1), $NF}' | xargs)
	
    # Assign default values based on conditions for value2
    if [[ "$value2" == "does not exist." ]]; then
        value2="Does not exist"
    else
        if [[ "$title" == "pref.xml system level directory" ]]; then
            if grep -wq ".systemPrefs/com/inet/report/config/cc/Default/prefs.xml" "$Input_File2"; then
                value2="System level folder & file found"
            fi
        elif [[ "$title" == "pref.xml user level directory" ]]; then
            if grep -wq ".java/.userPrefs/com/inet/report/config/cc/Default/prefs.xml" "$Input_File2"; then
                value2="$title Folder/File Found"
            fi
        else
            value2="$title Folder Found"
        fi
    fi

    # Print formatted output
    printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
}

print_homedir_section() {
    local title="$1"
    local pattern="$2"
    
    # Search in the first input file
    local value1=$(awk '/Backed up \/home\// {print $3}' "$Input_File1")
    
    # Search in the second input file
    local value2=$(awk '/Backed up \/home\// {print $3}' "$Input_File2")
	
    # Convert values into arrays for multi-line handling
    IFS=$'\n' read -d '' -r -a arr1 <<< "$value1"
    IFS=$'\n' read -d '' -r -a arr2 <<< "$value2"

    # Combine both arrays for comparison
    declare -A seen
    for item in "${arr1[@]}"; do seen["$item"]=1; done
    for item in "${arr2[@]}"; do seen["$item"]=$(( seen["$item"] + 2 )); done

    # Print process details with status comparison
    for key in "${!seen[@]}"; do
        case ${seen[$key]} in
            1) printf "%-40s | %-40s | %-40s | %-20s\n" "Name of the Directory" "$key" "Not Found" "Missing in File 2" ;;
            2) printf "%-40s | %-40s | %-40s | %-20s\n" "Name of the Directory" "Not Found" "$key" "Missing in File 1" ;;
            3) printf "%-40s | %-40s | %-40s | %-20s\n" "Name of the Directory" "$key" "$key" "Match" ;;
        esac
    done
printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
}

print_bashprofile_section() {
    local title="$1"

    # Get home directories from both input files
    home_dirs1=($(awk '/Backed up \/home\// {print $3}' "$Input_File1"))
    home_dirs2=($(awk '/Backed up \/home\// {print $3}' "$Input_File2"))

    # Count number of home directories found
    local count1=${#home_dirs1[@]}
    local count2=${#home_dirs2[@]}

    # Print total home directories found
    printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "File 1" "File 2" "Status"
    printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
    printf "%-40s | %-40s | %-40s | %-20s\n" "Total /home/ directories found" "$count1" "$count2" "---"

    # Declare associative arrays to store results
    declare -A status1 status2

    # Iterate over home directories to check for .bash_profile existence in File 1
    for dir in "${home_dirs1[@]}"; do
        local found=$(awk -v home="$dir" '
            $0 ~ "Backed up " home {start=1; next} 
            start && /Backed up \/home\// {exit} 
            start && /\.bash_profile/ {print "Found"; exit}
            END {if (!found) print "Not Found"}
        ' "$Input_File1")
        status1["$dir"]=$found
    done

    # Iterate over home directories to check for .bash_profile existence in File 2
    for dir in "${home_dirs2[@]}"; do
        local found=$(awk -v home="$dir" '
            $0 ~ "Backed up " home {start=1; next} 
            start && /Backed up \/home\// {exit} 
            start && /\.bash_profile/ {print "Found"; exit}
            END {if (!found) print "Not Found"}
        ' "$Input_File2")
        status2["$dir"]=$found
    done

    # Combine both arrays for comparison
    declare -A seen
    for dir in "${!status1[@]}"; do seen["$dir"]=1; done
    for dir in "${!status2[@]}"; do seen["$dir"]=$(( seen["$dir"] + 2 )); done

    # Print process details with status comparison
    for key in "${!seen[@]}"; do
        case ${seen[$key]} in
            1) printf "%-40s | %-40s | %-40s | %-20s\n" "$key/.bashprofile" "$key" "Not Found" "Missing in File 2" ;;
            2) printf "%-40s | %-40s | %-40s | %-20s\n" "$key/.bashprofile" "Not Found" "$key" "Missing in File 1" ;;
            3) printf "%-40s | %-40s | %-40s | %-20s\n" "$key/.bashprofile" "$key" "$key" "Match" ;;
        esac
    done
}


