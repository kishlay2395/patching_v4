# Function to extract system information from two files
print_sys_section() {
    local title="$1"
    local pattern="$2"

    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk '{$1=""; print $0}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk '{$1=""; print $0}' | xargs)

    [[ -z "$value1" ]] && value1="Not Found"
    [[ -z "$value2" ]] && value2="Not Found"

    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	if [[ "$value1" == "$value2" ]]; 
	then
		status="Validated"
	else	
		status="Need Attention"
	fi
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}

print_storage_section() {
    local title="$1"
    local pattern="$2"
    local value=""

    if [[ "$pattern" == "/data" ]]; then
        local value1=$(awk '/Filesystem\s+Size\s+Used\s+Avail\s+Use%/ {found=1} found; found && /^-+$/ {found=0}' "$Input_File1" \
            | grep "$pattern" | awk '{$1=""; print $NF}' | xargs)
			
		local value2=$(awk '/Filesystem\s+Size\s+Used\s+Avail\s+Use%/ {found=1} found; found && /^-+$/ {found=0}' "$Input_File1" \
            | grep "$pattern" | awk '{$1=""; print $NF}' | xargs)
			
    elif [[ "$pattern" == "Details of active (valid) symbolic links:" ]]; then 
        local value1=$(awk '/Details of active \(valid\) symbolic links:/ {found=1} found; found && /^-+$/ {found=0}'  "$Input_File2" \
            | grep "/data" | sort -u | awk '{$1=""; print $NF}' | xargs )  
			
        local value2=$(awk '/Details of active \(valid\) symbolic links:/ {found=1} found; found && /^-+$/ {found=0}'  "$Input_File2" \
            | grep "/data" | sort -u | awk '{$1=""; print $NF}' | xargs ) 			
    fi 

    [[ -z "$value1" ]] && value1="Not Found"
    [[ -z "$value2" ]] && value2="Not Found"
	
	if [[ "$value1" == "$value2" ]]; 
	then
		status="Validated"
	else	
		status="Need Attention"
	fi
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}

print_service_section() {
    local title="$1"
    local pattern="$2"
    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk '{$1=""; print $NF}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk '{$1=""; print $NF}' | xargs)

    if [[ -n "$value1" && $value1 != No* ]]; then
		if [[ -n "$value2" && $value2 != No* ]]; then
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi					
			printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
		else
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi
			printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "Not Found/Not Running" "$status"
		fi
    elif [[ -n "$value2" && $value2 != No* ]]; then
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi
        printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Not Found/Not Running" "$value2" "$status"
	else
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi		
		printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Not Found/Not Running" "Not Found/Not Running" "$status"
    fi

#        printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "Not Found/Not Running"
#    fi
}

print_service_section1() {
    local title="$1"
    local pattern="$2"
    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk '{$1=""; print $NF}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk '{$1=""; print $NF}' | xargs)
    # Handle missing values and "No*" conditions
    [[ -z "$value1" || "$value1" == No* ]] && value1="Not Found/Not Running"
    [[ -z "$value2" || "$value2" == No* ]] && value2="Not Found/Not Running"

    # Print the result in a structured format
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2"
}




