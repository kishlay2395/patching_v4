print_cron_section() {
    local title="$1"
    local pattern="$2"
    
    # Search in the first input file
    local value1=$(grep -m 1 "$pattern" -A 1 "$Input_File1" | awk 'NR==2 {print $1}' | xargs)
    
    # Search in the second input file
    local value2=$(grep -m 1 "$pattern" -A 1 "$Input_File2" | awk 'NR==2 {print $1}' | xargs)

    # Check the first value
    if [[ -n "$value1" && $value1 != No* ]]; then
		if [[ -n "$value2" && $value2 != No* ]]; then
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi		
			printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Cron Entries Found" "Cron Entries Found" "$status"
		else
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi				
			printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Cron Entries Found" "Cron Entries Not Found" "$status"
		fi
    elif [[ -n "$value2" && $value2 != No* ]]; then
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi			
        printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Cron Entries Not Found" "Cron Entries Found" "$status"
	else
			if [[ "$value1" == "$value2" ]]; then
				status="Validated"
			else	
				status="Need Attention"
			fi			
		printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "Cron Entries Not Found" "Cron Entries Not Found" "$status"
    fi
}


print_printer_section() {
    local title="$1"
    local pattern="$2"

    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk '{print $1}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk '{print $1}' | xargs)

    [[ -z "$value1" ]] && value1="Not Found"
    [[ -z "$value2" ]] && value2="Not Found"
	if [[ "$value1" == "$value2" ]]; then
		status="Validated"
	else	
		status="Need Attention"
	fi			

    printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}

print_batch_process_details() {
    local title="Batch Process Details"

    # Print header
	printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
    printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "File 1" "File 2" "Status"
    printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"

    # Extract values from both input files
    local value1=$(awk '
        /Daemon Process id and name details are given below/ { found=1; next }  
        found && NF { print $2}  
        found && /^-+$/ { exit }  
    ' "$Input_File1")

    local value2=$(awk '
        /Daemon Process id and name details are given below/ { found=1; next }  
        found && NF { print $2}  
        found && /^-+$/ { exit }  
    ' "$Input_File2")

    # Convert values into arrays for multi-line handling
    IFS=$'\n' read -d '' -r -a arr1 <<< "$value1"
    IFS=$'\n' read -d '' -r -a arr2 <<< "$value2"

    # Combine both arrays for comparison
    declare -A seen
    for item in "${arr1[@]}"; do seen["$item"]=1; done
    for item in "${arr2[@]}"; do seen["$item"]=$(( seen["$item"] + 2 )); done

    # Print process details with status comparison
    for key in "${!seen[@]}"; do
        case ${seen[$key]} in
            1) printf "%-40s | %-40s | %-40s | %-20s\n" "Batch Process Name" "$key" "Not Found" "Missing After Patching" ;;
            2) printf "%-40s | %-40s | %-40s | %-20s\n" "Batch Process Name" "Not Found" "$key" "Missing Before Patching" ;;
            3) printf "%-40s | %-40s | %-40s | %-20s\n" "Batch Process Name" "$key" "$key" "Validated" ;;
        esac
    done
	
	# Extract app process count from both files
    local app_count1=$(awk '/Total number of Batch application process available is/ {print $NF}' "$Input_File1" | xargs)
    local app_count2=$(awk '/Total number of Batch application process available is/ {print $NF}' "$Input_File2" | xargs)

    # Handle missing values
    [[ -z "$app_count1" ]] && app_count1="Not Found"
    [[ -z "$app_count2" ]] && app_count2="Not Found"
	
	if [[ "$app_count1" == "$app_count2" ]]; then
		status="Validated"
	else	
		status="Need Attention"
	fi			
	

    # Print app process count
	printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
    printf "%-40s | %-40s | %-40s | %-20s\n" "BatchApp Processes Running" "$app_count1" "$app_count2" "$status"
	
	printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
}

print_app_process_details() {
    local title="Application Process Details"
	# Print header
	printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
    printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "File 1" "File 2" "Status"
    printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"

    local value1=$(awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { 
            if (found) exit;  
            found=1;
            next;
        }
        found { print $4}
    ' "$Input_File1")

    local value2=$(awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { 
            if (found) exit;  
            found=1;
            next;
        }
        found { print $4}
    ' "$Input_File2")

    # Convert values into arrays for multi-line handling
    IFS=$'\n' read -d '' -r -a arr1 <<< "$value1"
    IFS=$'\n' read -d '' -r -a arr2 <<< "$value2"

    # Combine both arrays for comparison
    declare -A seen
    for item in "${arr1[@]}"; do seen["$item"]=1; done
    for item in "${arr2[@]}"; do seen["$item"]=$(( seen["$item"] + 2 )); done

    # Print process details with status comparison
    for key in "${!seen[@]}"; do
        case ${seen[$key]} in
            1) printf "%-40s | %-40s | %-40s | %-20s\n" "App Process Name" "$key" "Not Found" "Missing After Patching" ;;
            2) printf "%-40s | %-40s | %-40s | %-20s\n" "App Process Name" "Not Found" "$key" "Missing Before Patching" ;;
            3) printf "%-40s | %-40s | %-40s | %-20s\n" "App Process Name" "$key" "$key" "Validated" ;;
        esac
    done
	
	# Extract app process count from both files
    local app_count1=$(awk '/Total number of App processes on/ {print $NF}' "$Input_File1" | xargs)
    local app_count2=$(awk '/Total number of App processes on/ {print $NF}' "$Input_File2" | xargs)

    # Handle missing values
    [[ -z "$app_count1" ]] && app_count1="Not Found"
    [[ -z "$app_count2" ]] && app_count2="Not Found"
	
	
	if [[ "$app_count1" == "$app_count2" ]]; then
		status="Validated"
	else	
		status="Need Attention"
	fi	

    # Print app process count
    printf "%-40s | %-40s | %-40s | %-20s\n" "App Processes Running" "$app_count1" "$app_count2" "$status"
	printf "%-40s | %-40s | %-40s | %-20s\n" "----------------------------------------" "----------------------------------------" "----------------------------------------" "--------------------"
}


print_app_status_details() {
    local title="Application Process Details"

    # Header
    printf "\n%-40s | %-20s | %-17s | %-20s | %-17s | %-20s\n" \
        "URL Address" "Pre-Check-Status" "Post-Check-Status" "StatusCmp" "Pre_Http_Code" "Post_Http_Code"
    printf "%-40s | %-20s | %-17s | %-20s | %-17s | %-20s\n" \
        "----------------------------------------" "--------------------" "-----------------" "--------------------" "-----------------" "--------------------"

    declare -A file1_status file2_status file1_code file2_code

    # Parse Input_File1 (Pre-check)
    while read -r url status code; do
        file1_status["$url"]="$status"
        file1_code["$url"]="$code"
    done < <(awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { if (found) exit; found=1; next }
        found { print $6, $7, $8 }
    ' "$Input_File1")

    # Parse Input_File2 (Post-check)
    while read -r url status code; do
        file2_status["$url"]="$status"
        file2_code["$url"]="$code"
    done < <(awk '
        /^PID/ { found_header=1; next }
        /^-+/ && found_header { if (found) exit; found=1; next }
        found { print $6, $7, $8 }
    ' "$Input_File2")

    # Compare and display results
    for url in "${!file1_status[@]}"; do
        status1="${file1_status[$url]}"
        status2="${file2_status[$url]}"
        code1="${file1_code[$url]}"
        code2="${file2_code[$url]}"

        status_cmp="Validated"
        [[ "$status1" != "$status2" ]] && status_cmp="Need Attention"

        printf "%-40s | %-20s | %-17s | %-20s | %-17s | %-20s\n" \
            "$url" "$status1" "$status2" "$status_cmp" "$code1" "$code2"
    done
}


