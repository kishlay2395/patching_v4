#!/bin/bash

# Input files
Input_File1="$1"
Input_File2="$2"

# Check if the input files exist
if [[ ! -f "$Input_File1" ]]; then
    echo "Input file not found: $Input_File1"
    exit 1
fi

if [[ ! -f "$Input_File2" ]]; then
    echo "Input file not found: $Input_File2"
    exit 1
fi

# Function to compare values between two files

print_section_values() {
    local title="$1"
    local pattern="$2"
    
    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk -F ':|=' '{print $2}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk -F ':|=' '{print $2}' | xargs)

    [[ -z "$value1" ]] && value1="Not Found"
    [[ -z "$value2" ]] && value2="Not Found"

    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	if [[ "$value1" == "$value2" ]]; 
	then
		status="Validated"
	else	
		status="Need Attention"
	fi
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}


print_section_memory() {
    local title="$1"
    local pattern="$2"
    
    local value1=$(grep -m 1 "$pattern" "$Input_File1" | awk -F ':|=' '{print $2}' | xargs)
    local value2=$(grep -m 1 "$pattern" "$Input_File2" | awk -F ':|=' '{print $2}' | xargs)

    [[ -z "$value1" ]] && value1="Not Found"
    [[ -z "$value2" ]] && value2="Not Found"

    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	if [[ "$value1" == "$value2" ]]; 
	then
		status="Validated"
	else	
		status="Need Attention ($value1 / $value2)"
	fi
    #printf "%-40s | %-40s | %-40s\n" "$title" "$value1" "$value2"
	printf "%-40s | %-40s | %-40s | %-20s\n" "$title" "$value1" "$value2" "$status"
}

